# Copy this file to .env and fill in your values.
# .env is in .gitignore and must never be committed.

# Storage layout overrides (optional)
# By default the project reads/writes relative to the repo root
# (./data, ./outputs). Set these only if your data or output directories
# live somewhere else on disk.
# BURNSEG_DATASET_ROOT=./data
# BURNSEG_OUTPUT_ROOT=./outputs
# BURNSEG_KML_DIR=./data/aoi
# BURNSEG_CHECKPOINT_DIR=./outputs/checkpoints
# BURNSEG_MLFLOW_TRACKING_URI=./outputs/mlruns

# --- Google Earth Engine (only needed for scripts/*.py in the acquisition
#     pipeline; not required to train or evaluate on an existing dataset) ---
SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GEE_PROJECT=your-gee-project-id
